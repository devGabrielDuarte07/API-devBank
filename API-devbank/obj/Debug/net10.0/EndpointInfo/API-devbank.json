  "components": {
    "schemas": {
      "CriarChaveRequest": {
        "type": "object",
        "properties": {
          "tipo": {
            "$ref": "#/components/schemas/TipoChave"
          },
          "chave": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CriarUsuarioRequest": {
        "required": [
          "cpf",
          "email",
          "nome",
          "senha",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "cpf": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "telefone": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "senha": {
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EnviarPixRequest": {
        "type": "object",
        "properties": {
          "chave": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "default": "teste3@gmail.com",
            "nullable": true
          },
          "senha": {
            "minLength": 1,
            "type": "string",
            "default": "Aa123456"
          }
        },
        "additionalProperties": false
      },
      "TipoChave": {
        "enum": [
          "CPF",
          "EMAIL",
          "TELEFONE"
        ],
        "type": "string"
      },
      "TransferenciaRequest": {
        "type": "object",
        "properties": {
          "cpfContaDestino": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ValorRequest": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}